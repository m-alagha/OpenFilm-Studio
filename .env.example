# Optional overrides for local development. Copy to .env only if you need them; .env is git-ignored.
# Never commit real values. No key is needed: the mock (demo) provider works without credentials.

# Provider used by the app: "mock" (default, free, offline). Real providers arrive at M5.
OPENFILM_PROVIDER=mock

# Gemini Developer API key (paid tier required for gemini-omni-1.2-flash).
# Leave empty. From M5 the app stores keys in the OS credential store instead of this file.
GEMINI_API_KEY=

# User-data directory (projects, media, SQLite, backups). Must be an absolute path outside the
# app/repository. Default: the OS data folder (see README "Where your data is stored").
OPENFILM_DATA_DIR=

# Backend (engine) and UI ports, always bound to 127.0.0.1.
OPENFILM_PORT=8765
OPENFILM_UI_PORT=5173

# Bind address. Non-loopback values are refused unless OPENFILM_ALLOW_NON_LOOPBACK=1
# (isolated containers only; the API has no authentication).
OPENFILM_HOST=127.0.0.1
OPENFILM_ALLOW_NON_LOOPBACK=

# Set to 0 to disable update checks (M1.5), e.g. for CI or air-gapped machines.
OPENFILM_UPDATE_CHECK=
