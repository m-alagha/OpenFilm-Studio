__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node ---
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*

